{
  "name": "@achorde/source-catalog",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Runtime-light contracts and validators for read-only achorde source catalogs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitodisse/achorde.git",
    "directory": "packages/source-catalog"
  },
  "bugs": {
    "url": "https://github.com/saitodisse/achorde/issues"
  },
  "homepage": "https://github.com/saitodisse/achorde/tree/main/packages/source-catalog#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
