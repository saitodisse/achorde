{
  "name": "@achorde/musical-domain",
  "version": "0.6.0",
  "private": false,
  "type": "module",
  "description": "Shared musical domain contracts for chord charts, parsed tabs and fretted voicings.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitodisse/achorde.git",
    "directory": "packages/musical-domain"
  },
  "bugs": {
    "url": "https://github.com/saitodisse/achorde/issues"
  },
  "homepage": "https://musical-domain.vercel.app/",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm dev:site",
    "dev:site": "vite --config vite.config.site.ts",
    "build:site": "vite build --config vite.config.site.ts",
    "preview:site": "vite preview --config vite.config.site.ts --outDir dist-site",
    "storybook": "storybook dev -p 6005 --no-open",
    "build-storybook": "storybook build",
    "prepare": "pnpm build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@achorde/storybook-config": "workspace:*",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "^5.9.3",
    "storybook": "^10.4.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.6"
  }
}
