{
  "name": "@achorde/catalog-portal",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Core editorial, deterministic catalog, React, and browser adapters for achorde catalog portals.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./browser": { "types": "./dist/browser.d.ts", "default": "./dist/browser.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": { "react": "^18.0.0 || ^19.0.0" },
  "dependencies": {
    "@achorde/contribution-protocol": "workspace:^0.2.0",
    "@achorde/source-catalog": "workspace:^0.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "react": "^19.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
