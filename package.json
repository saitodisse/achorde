{
  "name": "achorde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:all",
    "dev:all": "sh -c 'pnpm dev:musical-domain & pnpm dev:tab-renderer & pnpm dev:svguitar-react & pnpm dev:interactive-fretboard & pnpm storybook:tab-renderer & pnpm storybook:tab-editor & pnpm storybook:svguitar & pnpm storybook:interactive-fretboard & wait'",
    "dev:musical-domain": "pnpm --filter @achorde/musical-domain dev -- --host 127.0.0.1 --port 5286 --strictPort",
    "dev:tab-renderer": "pnpm --filter @achorde/tab-renderer dev -- --host 127.0.0.1 --port 5283 --strictPort",
    "dev:svguitar-react": "pnpm --filter @achorde/svguitar-react dev -- --host 127.0.0.1 --port 5284 --strictPort",
    "dev:interactive-fretboard": "pnpm --filter @achorde/interactive-fretboard dev -- --host 127.0.0.1 --port 6011 --strictPort",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "storybook:tab-renderer": "pnpm --filter @achorde/tab-renderer storybook",
    "storybook:tab-editor": "pnpm --filter @achorde/tab-editor storybook",
    "storybook:svguitar": "pnpm --filter @achorde/svguitar-react storybook",
    "storybook:svguitar-react": "pnpm storybook:svguitar",
    "storybook:interactive-fretboard": "pnpm --filter @achorde/interactive-fretboard storybook"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  }
}
