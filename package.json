{
  "name": "achorde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm dev:all",
    "dev:all": "sh -c 'turbo run dev --parallel & pnpm storybook:musical-domain & pnpm storybook:tab-renderer & pnpm storybook:svguitar & pnpm storybook:interactive-fretboard & wait'",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "storybook:musical-domain": "pnpm --filter @achorde/musical-domain storybook",
    "storybook:tab-renderer": "pnpm --filter @achorde/tab-renderer storybook",
    "storybook:svguitar": "pnpm --filter @achorde/svguitar-react storybook",
    "storybook:interactive-fretboard": "pnpm --filter @achorde/interactive-fretboard storybook"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  }
}
