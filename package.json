{
  "name": "achorde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "storybook:tab-renderer": "pnpm --filter tab-renderer storybook",
    "storybook:svguitar": "pnpm --filter svguitar-react storybook",
    "storybook:interactive-fretboard": "pnpm --filter @achorde/interactive-fretboard storybook"
  },
  "devDependencies": {
    "turbo": "^2.6.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.3"
    }
  }
}
